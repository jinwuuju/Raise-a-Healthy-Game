          "id",
          "title",
          "question",
          "offer",
          "region",
          "conceptIds",
          "observations",
          "tasks",
          "cards",
          "acceptedLinks",
          "headline",
          "alternateHeadline",
          "limitations",
          "sources",
          "debrief",
          "unlockText"
        ],
        "additionalProperties": false
