          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "alternateHeadline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "limitations": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "minItems": 1
          },
