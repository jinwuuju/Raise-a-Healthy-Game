      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "checkedAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "updatedAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
