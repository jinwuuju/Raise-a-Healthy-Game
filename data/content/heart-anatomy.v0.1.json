        "medlineplus-conduction"
      ]
    },
    {
      "id": "bundle-branches",
      "title": "좌·우 각",
      "kind": "conduction",
      "x": 145,
      "y": 158,
      "text": "히스속 이후 좌·우 심실 방향으로 나뉘는 전도계.",
      "sources": [
        "medlineplus-conduction"
      ]
    },
    {
      "id": "purkinje",
      "title": "푸르키네 섬유",
